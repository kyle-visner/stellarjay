# A DNS A/AAAA record for this name must point at the host.
STELLARJAY_DOMAIN=stellarjay.example.com

# Bound local resource use and snapshot accumulation.
STELLARJAY_CPUS=1.0
STELLARJAY_MEMORY_LIMIT=512m
CADDY_CPUS=0.5
CADDY_MEMORY_LIMIT=256m
STELLARJAY_SNAPSHOT_RETENTION=24
# Set to 0 to disable the free-space reserve (not recommended on shared disks).
STELLARJAY_SNAPSHOT_MIN_FREE_BYTES=536870912
# Per-credential API requests and global failed authentication attempts.
STELLARJAY_RATE_LIMIT_PER_MINUTE=600
STELLARJAY_FAILED_AUTH_LIMIT_PER_MINUTE=30
# Optional off-host root pin. Readiness fails if this root is absent from history.
STELLARJAY_MINIMUM_ROOT=
# Optional catalog file on the writable data volume. Leave unset for open writes.
# STELLARJAY_CATALOG_FILE=/var/lib/stellarjay/catalog.json
